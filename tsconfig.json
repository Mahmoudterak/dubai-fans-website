{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./public/assets/*"],
      "@workspace/dubai-fans-ds": ["./src/vendor/dubai-fans-ds/generated/tokens.tsx"],
      "@workspace/dubai-fans-ds/tokens": ["./src/vendor/dubai-fans-ds/generated/tokens.tsx"],
      "@workspace/dubai-fans-ds/components/*": ["./src/vendor/dubai-fans-ds/components/*"],
      "@workspace/dubai-fans-ds/lib/*": ["./src/vendor/dubai-fans-ds/lib/*"],
      "@workspace/dubai-fans-ds/hooks/*": ["./src/vendor/dubai-fans-ds/hooks/*"],
      "@workspace/blog-data": ["./src/vendor/blog-data/index.ts"],
      "@workspace/api-client-react": ["./src/vendor/api-client-react/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
